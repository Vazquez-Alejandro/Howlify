# ============================================================
# HOWLIFY - Environment Variables
# ============================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ─── Supabase ──────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
SUPABASE_JWT_SECRET=your_jwt_secret

# ─── Server ────────────────────────────────────────────────
PORT=8000
HOWLIFY_MODE=api
APP_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─── MercadoPago ───────────────────────────────────────────
MP_ACCESS_TOKEN=your_mp_access_token
MP_WEBHOOK_SECRET=your_webhook_secret
MP_PRICE_PRO_ARS=3000
MP_DURATION_DAYS=30

# ─── Duffel (Flights) ─────────────────────────────────────
DUFFEL_ACCESS_TOKEN=your_duffel_token

# ─── Notifications ─────────────────────────────────────────
TELEGRAM_TOKEN=your_telegram_bot_token
TELEGRAM_BOT_USERNAME=YourBotName
WHATSAPP_TOKEN=your_whatsapp_token
RESEND_API_KEY=your_resend_key
RESEND_FROM_EMAIL=noreply@yourdomain.com

# ─── Rate Limiting ─────────────────────────────────────────
RATE_WINDOW_SECONDS=30
RATE_MAX_REQUESTS=2
ALERT_COOLDOWN_MINUTES=30

# ─── Scraper ───────────────────────────────────────────────
OH_PLAYWRIGHT=0
PROXY_BACKEND=direct
SCRAPERAPI_KEY=

# ─── Google Sheets Export ──────────────────────────────────
GOOGLE_SHEETS_CREDENTIALS=credenciales.json
GOOGLE_SHEETS_TOKEN=token.json
GOOGLE_SHEETS_ID=

# ─── Push Notifications (PWA) ──────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=mailto:howlify@example.com

# ─── Celery/Redis ──────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CELERY_CONCURRENCY=2

# ─── Debug ─────────────────────────────────────────────────
DEBUG=0
PAYMENT_ENABLED=false
