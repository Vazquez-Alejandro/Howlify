# =============================================================================
# HOWLIFY — Variables de Entorno (copia este archivo como .env y completá)
# =============================================================================

# --- Supabase (DB + Auth) ---
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIs...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIs...

# --- Telegram ---
TELEGRAM_TOKEN=123456:ABC-DEF...
TELEGRAM_CHAT_ID=123456789

# --- WhatsApp (Whapi.cloud) ---
WHATSAPP_TOKEN=tu_token_whapi

# --- Email (Resend) ---
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=Howlify <onboarding@resend.dev>

# --- Email (SMTP alternativo) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=tu_email@gmail.com
SMTP_PASSWORD=tu_app_password
SMTP_FROM=tu_email@gmail.com
SMTP_USE_TLS=1
SMTP_USE_SSL=0

# --- Redis (Cola de tareas) ---
REDIS_URL=redis://localhost:6379/0

# --- App ---
APP_BASE_URL=https://howlify.onrender.com
ALERT_COOLDOWN_MINUTES=30
# Modo beta: false = todo gratis, true = cobrar con Mercado Pago
PAYMENT_ENABLED=false

# --- Scraping ---
SCRAPERAPI_KEY=tu_key

# --- Google Sheets (exportación) ---
# Ruta al archivo JSON de credenciales de Service Account
# Descargar desde: https://console.cloud.google.com/apis/credentials
GOOGLE_SHEETS_CREDENTIALS=credenciales.json
# ID del sheet (de la URL: https://docs.google.com/spreadsheets/d/<ID>/edit)
GOOGLE_SHEETS_ID=

# --- Mercado Pago / Pagos ---
# 1. Crear cuenta en https://mercadopago.com.ar (vendedor)
# 2. Ir a Credenciales > copiar Access Token (producción)
# 3. Configurar Webhook / IPN en: https://mercadopago.com.ar/ipn-notifications
#    URL: https://tudominio.com/api/mp/webhook
#    Eventos: "Pagos"
# 4. Configurar Checkout Pro > Preference > Notification URL
MP_ACCESS_TOKEN=APP_USR-123456789-...
# Precios en ARS (sin puntos ni comas)
MP_PRICE_PRO_ARS=3000
MP_PRICE_RESELLER_ARS=8000
MP_PRICE_MONITOR_ARS=12000

# --- Afiliados ---
ML_AFFILIATE_TOKEN=tu_partner_id
DESPEGAR_AFFILIATE_TAG=howlify

# --- Travel API ---
DUFFEL_ACCESS_TOKEN=duffel_test_...
