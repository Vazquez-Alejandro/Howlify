# Frontend React — Variables de Entorno
# En desarrollo: vite hace proxy /api -> localhost:8000
# En producción: FastAPI sirve el SPA y la API en el mismo origen, dejalo vacío
VITE_API_URL=http://localhost:8000
# Admin emails (separados por coma) - usados como fallback si la API no responde
VITE_ADMIN_EMAILS=howlify.app@gmail.com
